{
  "name": "rosellaview-surface",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "react-native.config.js"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "build:js": "tsc -p tsconfig.json",
    "build:native:release": "vega build -b Release",
    "build:native:debug": "vega build -b Debug",
    "build": "npm-run-all build:js build:native:release"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "4.8.4"
  },
  "kepler": {
    "projectType": "turbomodule",
    "targets": [
      "tv"
    ]
  }
}
